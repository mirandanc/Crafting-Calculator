{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crafting-calculator",
  "compatibility_date": "2026-11-01",
  // The Worker only answers /api/* (see assets.run_worker_first); everything else is the Vite build.
  "main": "./worker/index.ts",
  // Lets Wrangler's bundler resolve the @worker/ alias.
  "tsconfig": "./worker/tsconfig.json",
  // Wrangler runs the Vite build itself, so deploys work even without a dashboard build command.
  "build": {
    "command": "npm run build"
  },
  // Required by `wrangler preview`, which Cloudflare runs for pull-request builds. Bindings are not inherited from
  // the top level, so previews list the KV namespace again (they only ever read the production prices).
  "previews": {
    "kv_namespaces": [
      { "binding": "AUCTION_PRICES", "id": "630acd3b18394310824cec768eaa53f2" }
    ]
  },
  // FOREVERDB_API_KEY is a secret set in the dashboard (Production and Previews Base). It is not listed under
  // secrets.required: that makes deploys fail while it is missing, and Cloudflare only accepts the secret once a
  // deploy with Worker code exists.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Filled six times a day by .github/workflows/auction-prices.yml: `auction-prices` (served at /api/auction-prices)
  // and `auction-history` (the job's own snapshot and sales history, never served).
  "kv_namespaces": [
    { "binding": "AUCTION_PRICES", "id": "630acd3b18394310824cec768eaa53f2" }
  ]
}
