# Copy this file to .env (and to .dev.vars for `npm run dev:worker`), then replace the values with your own.
# .env and .dev.vars are git-ignored; never put real keys in this file.
FOREVERDB_API_KEY=paste-your-key-here
# Battle.net API client (https://community.developer.battle.net/access/clients), only for `npm run fetch:auction-prices`.
BLIZZARD_CLIENT_ID=paste-your-client-id-here
BLIZZARD_CLIENT_SECRET=paste-your-client-secret-here
