{
  "name": "crafting-calculator",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "fetch:recipes": "node --env-file-if-exists=.env scripts/fetch-recipes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirandanc/Crafting-Calculator.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/mirandanc/Crafting-Calculator/issues"
  },
  "homepage": "https://github.com/mirandanc/Crafting-Calculator#readme",
  "private": true,
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
